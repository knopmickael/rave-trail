# Modelo das variaveis de producao usadas por deploy/docker-compose.prod.yaml.
# Copie para deploy/.env.prod NA INSTANCIA Lightsail e preencha.
# deploy/.env.prod NAO e versionado (contem segredos).

# Dominio publico do jogo (sem https://, sem barra). Usado pelo Caddy para o TLS.
APP_DOMAIN=rave-trail.com.br

# Origem exata usada pelo navegador. O backend valida Origin nas mutacoes
# e exige https em producao. Deve casar com APP_DOMAIN.
APP_ORIGIN=https://rave-trail.com.br

# Credenciais do PostgreSQL no mesmo box. Troque a senha por um valor forte.
POSTGRES_USER=rave_trail
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
POSTGRES_DB=rave_trail

# Imagem da aplicacao no ECR. Normalmente e sobrescrita pelo CI/CD a cada deploy,
# mas manter um valor aqui permite subir a stack manualmente.
APP_IMAGE=123456789012.dkr.ecr.us-east-2.amazonaws.com/rave-trail:latest
