# Modelo do CMS. Use como base para .env.cms.local e .env.cms.prod.
# O comando legado npm run cms continua usando .env.cms.
# A URL usa a porta LOCAL do túnel. Codifique caracteres especiais da senha na URL.
CMS_DATABASE_URL=postgres://usuario:senha@127.0.0.1:5438/rave_trail
CMS_DATABASE_LABEL=Produção · Rave Trail
CMS_WEB_PORT=5188
CMS_API_PORT=3188

CMS_SSH_HOST=
CMS_SSH_USER=ubuntu
CMS_SSH_PORT=22
CMS_SSH_KEY=
CMS_SSH_LOCAL_PORT=5438
CMS_SSH_DB_PORT=5432

# API compatível com OpenAI Chat Completions (incluindo Ollama /v1).
# Segredos ficam somente no servidor local. Modelo deve aceitar response_format json_object.
CMS_AI_BASE_URL=https://api.openai.com/v1
CMS_AI_MODEL=
CMS_AI_API_KEY=
