{
  "name": "rave-trail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --config frontend/vite.config.ts --host 127.0.0.1",
    "dev:api": "tsx watch --tsconfig backend/tsconfig.json backend/src/index.ts",
    "assets:sky": "node tools/assets/generate-sky.mjs",
    "assets:battles": "node tools/assets/generate-battle-backgrounds.mjs",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build --config frontend/vite.config.ts",
    "build:api": "node tools/build-api.mjs",
    "clean": "node tools/clean-builds.mjs",
    "start": "node backend/dist/index.js",
    "typecheck": "tsc -p frontend/tsconfig.json && tsc -p backend/tsconfig.json && tsc -p shared/tsconfig.json && tsc -p tsconfig.json",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:db": "vitest run --config config/vitest.db.config.ts",
    "test:architecture": "vitest run --config config/vitest.config.ts tools/architecture.test.ts",
    "smoke:production": "node tools/smoke-production.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "tsx --tsconfig backend/tsconfig.json backend/src/db/migrate.ts",
    "db:seed": "tsx --tsconfig backend/tsconfig.json backend/src/db/seed-cli.ts",
    "assets:mocks": "node --import tsx tools/assets/generate-mock-art.mjs",
    "assets:campaigns": "node tools/assets/generate-campaign-art.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.8",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.0"
  },
  "overrides": { "vite": "$vite" },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.4.0",
    "vitest": "^4.1.12"
  }
}
